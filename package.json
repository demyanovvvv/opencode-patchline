{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-patchline",
  "version": "1.2.0",
  "description": "Snapshot-aware, stale-safe precision code editing for OpenCode.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/demyanovvvv/opencode-patchline#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/demyanovvvv/opencode-patchline.git"
  },
  "bugs": {
    "url": "https://github.com/demyanovvvv/opencode-patchline/issues"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.0 <2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "bin": {
    "opencode-patchline": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "install.sh",
    "uninstall.sh",
    "install.ps1",
    "uninstall.ps1"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "doctor": "tsx src/cli.ts doctor",
    "check:release": "node scripts/check-release.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "smoke:native-host": "npm run build && node scripts/native-host-smoke.mjs",
    "bench": "tsx benchmarks/runner.ts",
    "smoke:plugin": "npm run build && node scripts/plugin-smoke.mjs",
    "smoke:hashline": "npm run build && npm exec --yes --package=bun -- bun --conditions=browser scripts/hashline-smoke.mjs",
    "smoke:hashline:differential": "npm run build && npm exec --yes --package=bun -- bun --conditions=browser scripts/hashline-differential.mjs",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs",
    "smoke:tui": "npm run build && npm exec --yes --package=bun -- bun --conditions=browser scripts/tui-smoke.mjs",
    "smoke:install": "npm run build && node scripts/install-smoke.mjs",
    "smoke:installer-lifecycle": "npm run build && node scripts/installer-lifecycle-smoke.mjs",
    "smoke:host": "npm run build && node scripts/installer-lifecycle-smoke.mjs --host",
    "smoke:installer-lsp": "npm run build && node scripts/installer-lsp-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@node-rs/xxhash": "^1.7.8",
    "@oh-my-pi/hashline": "18.1.5",
    "@oh-my-pi/pi-natives": "18.1.5",
    "@opencode-ai/plugin": "1.18.30",
    "@opentui/solid": "0.4.5",
    "diff": "^8.0.2",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.16",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-preset-solid": "1.9.16",
    "eslint": "^9.36.0",
    "source-map-js": "^1.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@opentui/solid": {
      "solid-js": "$solid-js",
      "babel-preset-solid": "$babel-preset-solid",
      "@babel/core": "$@babel/core"
    }
  },
  "main": "./dist/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "code-editing",
    "developer-tools",
    "stale-safe",
    "snapshot"
  ],
  "author": "Patchline contributors"
}
